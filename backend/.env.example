# ==============================================================================
# VanSetu Platform — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env for local development.
# Real .env files are excluded via .gitignore.

DEBUG=False
PORT=8000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=urban_green_corridors

# External Environmental APIs
OPENAQ_API_KEY=your_openaq_key_here

# ------------------------------------------------------------------------------
# Prune AI Gateway (Backend Only)
# ------------------------------------------------------------------------------
PRUNE_API_KEY=prune_your_key_here
PRUNE_BASE_URL=https://api.withprune.com/v1
PRUNE_MODEL=gemini-2.0-flash
