# ==============================================================================
# VanSetu Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or root for local development.
# NEVER commit real API keys, credentials, or secrets to version control.

# Server & Runtime
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=urban_green_corridors

# External Environmental APIs
OPENAQ_API_KEY=your_openaq_key_here

# ------------------------------------------------------------------------------
# Prune AI Gateway (Backend Only)
# ------------------------------------------------------------------------------
# 1. Sign up at https://app.withprune.com with your dedicated event account
# 2. Vault your Google Gemini API key under Connect > Providers
# 3. Generate a Prune API key (format: prune_...) under Connect > API Keys
# 4. Set PRUNE_API_KEY below. Do NOT expose this key to the frontend or client.
PRUNE_API_KEY=prune_your_key_here
PRUNE_BASE_URL=https://api.withprune.com/v1
PRUNE_MODEL=gemini-2.0-flash
